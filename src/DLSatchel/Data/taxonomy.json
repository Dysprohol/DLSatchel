{
  "_comment": "DDV item taxonomy. Every rule cites its evidence: 'pliki_testowe/Dane filtra.txt' (user's own classification) or the shipped game file ddv_Data/StreamingAssets/game_object_def.json (game 1.25.3) which marks which categories are 'ownable'. Edit this file instead of adding ifs in code.",
  "schemaVersion": 1,
  "subtypeSeparators": [
    "/",
    "!"
  ],
  "kindRules": [
    {
      "type": "ActivityData",
      "namePrefix": "CookingRecipe",
      "kind": "Recipe",
      "placement": "None",
      "_comment": "Dane filtra.txt line 1: 'ActivityData - Cooking - kolekcja'. A recipe is unlocked in Cookbook, not carried in the backpack."
    },
    {
      "type": "ActivityData",
      "namePrefix": "CraftingRecipe",
      "kind": "Recipe",
      "placement": "None",
      "_comment": "Dane filtra.txt line 4: 'Crafting - kolekcja (/mission to crafty z misji)'."
    },
    {
      "type": "ActivityData",
      "namePrefix": "MiningData",
      "kind": "Unknown",
      "placement": "None",
      "_comment": "Dane filtra.txt line 3: 'Mining - kolekcja'. ActivityData entries are collection counters, not backpack items."
    },
    {
      "type": "ActivityData",
      "namePrefix": "FishingData",
      "kind": "Unknown",
      "placement": "None",
      "_comment": "Dane filtra.txt line 2: 'Ryby - kolekcja'."
    },
    {
      "type": "ActivityData",
      "namePrefix": "TimeBendingData",
      "kind": "Unknown",
      "placement": "None",
      "_comment": "Dane filtra.txt line 5: 'Timebending - kolekcja'."
    },
    {
      "type": "ActivityData",
      "namePrefix": "PremadeDecorationPreset",
      "kind": "DecorationPreset",
      "placement": "DecorationPreset",
      "_comment": "KOSDDV dump (2026): Gameloft presets are ActivityData/PremadeDecorationPreset/..., the same records as itemlist/ActivityData.json. Unlocked in Player.PremadeDecorationPresets."
    },
    {
      "type": "ActivityData",
      "kind": "Unknown",
      "placement": "None",
      "_comment": "Catch-all for ActivityData: never a backpack item."
    },
    {
      "type": "Companion",
      "namePrefix": "Mount",
      "kind": "Companion",
      "placement": "None",
      "_comment": "Companion/Mount/... is a mount, stored in Player.Mounts, not Player.Pets."
    },
    {
      "type": "Companion",
      "namePrefix": "Snippet",
      "kind": "Companion",
      "placement": "None",
      "_comment": "Snippet creatures are not Player.Pets entries."
    },
    {
      "type": "Upgrade",
      "kind": "Tool",
      "placement": "None",
      "_comment": "Dane filtra.txt line 94: 'Upagrade - wszelkie ulepszenia narzedzi'. Held in Player.ToolUpgrades per tool."
    },
    {
      "type": "MemoryShard",
      "kind": "Memory",
      "placement": "Collection",
      "_comment": "Dane filtra.txt line 64: memory fragments; stored in CollectionSets / Player.MemoryShards."
    },
    {
      "type": "Set",
      "kind": "CollectionSet",
      "placement": "Collection",
      "_comment": "Dane filtra.txt line 80: 'Set - pelne kolekcje ubran, mebli etc'."
    },
    {
      "type": "CollectionSet",
      "kind": "CollectionSet",
      "placement": "Collection",
      "_comment": "Collection definitions are unlocked as a whole, not placed in a container."
    },
    {
      "type": "Character",
      "kind": "Unknown",
      "placement": "None",
      "_comment": "Dane filtra.txt line 35: 'Character - po prostu postacie, nie powielac'. game_object_def.json marks Character ownable, but it is not an inventory item."
    }
  ],
