  "testItemRules": [
    {
      "fields": [ "notes", "category" ],
      "pattern": "(?i)\\bTEST[ _]?ITEM\\b",
      "_comment": "Rubyelf marks developer assets with 'TEST ITEM' / 'TEST_ITEM' notes."
    },
    {
      "fields": [ "name" ],
      "pattern": "(?:^|[/!_])Test(?:Asset)?(?:[_!]|$)",
      "_comment": "Internal NAME with 'Test' as its own token: CloFeet/Feet_Test, CloTopInner/TestAsset!Shirt100. Real items like RorschachTest01 or StrengthTestBell are CamelCase and do not match."
    },
    {
      "fields": [ "display" ],
      "pattern": "(?:^|_)Test(?:_|$)|^Test[A-Z]",
      "_comment": "Raw developer names shown as display names: Hair_Test, TestBoulder. 'Ink Blot Test' or 'The Beast's Test' are real items and do not match."
    }
  ],
  "safetyRules": [
    {
      "state": "Caution",
      "matchAny": [
        "PIXEL DUST"
      ],
      "_comment": "Widoczne ostrzeżenie przy walucie online; użytkownik nadal może ją edytować świadomie."
    },
    {
      "state": "Unsafe",
      "matchAny": [
        "NOTHING",
        "PLACEHOLDER",
        "DEBUG",
        "DONT USE",
        "DON'T USE",
        "DO NOT USE",
        "NOT IN GAME",
        "UNRELEASED",
        "CAN BUG OUT YOUR SAVE",
        "BUGGED",
        "BREAKS YOUR SAVE",
        "BREAK YOUR SAVE",
        "WILL BREAK SAVE",
        "WILL BREAK GAME",
        "NEVER MAKE ORIGINAL"
      ],
      "fields": [ "display", "category", "notes", "catalogue" ],
      "ignoreAny": [
        "DONT USE IF YOU DONT HAVE THE DLC",
        "DONT USE UNLESS BROKEN QUEST",
        "ONLY IF BUGGED",
        "NO LONGER LISTED AS \"DEBUG\"",
        "NO LONGER LISTED AS DEBUG"
      ],
      "_comment": "Apostrophes are removed by the matcher, so 'DON'T USE' = 'DONT USE'. Only the source's own labels are read (display/category/notes/catalogue), never the internal NAME path: 'Ingredient/Mission!...CorruptedMushrooms' is a quest item, not a broken one. ignoreAny cuts conditional notes (DLC-only, broken-quest fixes, 'no longer Debug') before matching; the Caution rules below pick them up."
    },
    {
      "state": "Unsafe",
      "matchAny": [
        "CRASH",
        "CORRUPT"
      ],
      "fields": [ "category", "notes", "catalogue" ],
      "_comment": "Warning words only in the source's notes/categories: real items are named 'Corrupted Flower' or 'The De Vil Crash'."
    },
    {
      "state": "Caution",
      "matchAny": [
        "LANDSCAPING PATH"
      ],
      "_comment": "Paths use NAME namespace Landscaping/ but are accepted in the save's Furniture inventory as GroundAlteration; keep visible as caution until verified by loading the modified save in game."
    },
    {
      "state": "Caution",
      "matchAny": [
        "MISSION!",
        "EVENT!",
        "CHARACTER"
      ],
      "fields": [ "name", "type" ],
      "_comment": "Mission/event/character progression items remain addable only after a warning confirmation; their save effects are not fully verified. These are internal NAME/TYPE markers (Default/Mission!..., CharacterShard/..., TYPE Character), so display names like 'Character Styles' do not count."
    },
    {
      "state": "Caution",
      "matchAny": [
        "PREMIUM",
        "STAR PATH",
        "SECRET QUEST",
        "QUEST ITEM",
        "QUEST REWARD",
        "REQUESTITEM",
        "REQUEST ITEM",
        "EVENT",
        "SEASONAL",
        "BUNDLE",
        "CAREFUL",
        "DO NOT CRAFT",
        "DON'T CRAFT",
        "DONT CRAFT",
        "CHARACTER HOUSE",
        "CHARACTER'S HOUSE",
        "VILLAGER HOUSE",
        "IF YOU DONT HAVE THE DLC",
        "UNLESS BROKEN QUEST",
        "ONLY IF BUGGED",
        "CAN BUG",
        "COULD BUG",
        "BREAK QUEST",
        "BREAK GAME",
        "BREAK YOUR GAME",
        "NOT SURE IF SAFE",
        "WOULDNT USE"
      ],
      "fields": [ "name", "display", "category", "notes", "catalogue" ],
      "_comment": "Not matched against TYPE, so non-item types such as ConditionalEvent/RecurringEvent are not flagged just for containing 'Event'. Caution items are allowed but visible; the save itself depends on game/quest state. 'CAREFUL' covers notes like 'CAREFUL - ONLY USE IF A QUEST IS BROKEN'. External catalog notes containing Do Not Craft and character-house labels are caution-only."
    }
  ]
}
