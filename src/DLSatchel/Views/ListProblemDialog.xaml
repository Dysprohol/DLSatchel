<Window x:Class="DDV_SaveEditor_G.ListProblemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item List Problem"
        Icon="/DLSatchel;component/Assets/Icons/logo.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Starlight}"
        FontFamily="Segoe UI" FontSize="13"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11.5" Foreground="{StaticResource MutedStarlight}"/>
        <TextBlock x:Name="StillWorksText" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource DreamlightMint}"/>

        <TextBlock Text="What you can do:" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button x:Name="NewLinkButton" Content="Paste a new link…" Click="NewLink_Click" Padding="8,5" Margin="0,0,10,8"
                    Style="{StaticResource AccentButton}"/>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{StaticResource MutedStarlight}"
                       Text="If the people who make the list moved it, paste its new address."/>
            <Button Grid.Row="1" Content="Choose a file…" Click="ChooseFile_Click" Padding="8,5" Margin="0,0,10,8"/>
            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{StaticResource MutedStarlight}"
                       Text="Use an Excel file of the list you downloaded yourself."/>
            <Button Grid.Row="2" Content="Open the forum thread" Click="Forum_Click" Padding="8,5" Margin="0,0,10,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedStarlight}"
                       Text="The list makers post news and new links on the FearLess Revolution forum."/>
        </Grid>

        <TextBlock Text="Link that did not work:" Margin="0,8,0,2" FontSize="12" Foreground="{StaticResource MutedStarlight}"/>
        <TextBox x:Name="OldLinkBox" IsReadOnly="True" FontSize="12" Padding="4,2"/>

        <Button Content="Not now" IsCancel="True" Padding="14,5" Margin="0,14,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
