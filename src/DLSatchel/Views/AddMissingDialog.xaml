<Window x:Class="DDV_SaveEditor_G.AddMissingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add All Missing"
        Icon="/DLSatchel;component/Assets/Icons/logo.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Starlight}"
        FontFamily="Segoe UI" FontSize="13"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ItemsControl x:Name="GroupList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding HasItems}"
                                  Checked="Group_Changed" Unchecked="Group_Changed">
                            <TextBlock>
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{StaticResource DreamlightGold}"/>
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="22,2,0,0"
                                   Foreground="{StaticResource MutedStarlight}" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedStarlight}" FontSize="12"
                   Text="Items already placed in your valley count as yours. Never added: items marked unsafe or unreleased, and test items. One of each item is added; nothing is saved until you click Save Changes."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Click="Ok_Click" Padding="14,5" Margin="0,0,8,0"
                    IsDefault="True" Style="{StaticResource AccentButton}"/>
            <Button Content="Cancel" IsCancel="True" Padding="14,5"/>
        </StackPanel>
    </StackPanel>
</Window>
