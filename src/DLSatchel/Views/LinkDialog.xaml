<Window x:Class="DDV_SaveEditor_G.LinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item List from Link"
        Icon="/DLSatchel;component/Assets/Icons/logo.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Starlight}"
        FontFamily="Segoe UI" FontSize="13"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Paste the link of an item list in Google Sheets (or a direct link to an .xlsx file). The sheet must be shared so anyone with the link can view it."/>
        <TextBox x:Name="LinkBox" Padding="4" Margin="0,0,0,10" TextChanged="LinkBox_TextChanged"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Known lists:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedStarlight}"/>
            <Button Content="Rubyelf ID list" Click="Rubyelf_Click" Padding="8,3" Margin="0,0,8,0"/>
            <Button Content="KOSDDV item dump" Click="Kosddv_Click" Padding="8,3"/>
        </StackPanel>
        <TextBlock x:Name="ProblemText" Foreground="{StaticResource DreamlightGold}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Download and add" Click="Ok_Click" Padding="14,5" Margin="0,0,8,0"
                    IsDefault="True" IsEnabled="False" Style="{StaticResource AccentButton}"/>
            <Button Content="Cancel" IsCancel="True" Padding="14,5"/>
        </StackPanel>
    </StackPanel>
</Window>
