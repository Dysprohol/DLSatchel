<Window x:Class="DDV_SaveEditor_G.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDV_SaveEditor_G"
        mc:Ignorable="d"
        Title="Item Catalog Sources" Height="600" Width="900"
        Icon="/DLSatchel;component/Assets/Icons/logo.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Starlight}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="MonoStyle">
            <Setter Property="FontFamily" Value="Consolas,Monospace"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BtnAddFile" Content="＋ Add Excel" Click="BtnAddFile_Click" Margin="0,0,8,0" Padding="8,4"
                    ToolTip="Add catalogs next to the enabled ones; they are merged by priority (lower number wins)"/>
            <Button x:Name="BtnReplaceFile" Content="Use Only…" Click="BtnReplaceFile_Click" Margin="0,0,8,0" Padding="8,4"
                    ToolTip="Choose catalogs and disable all others"/>
            <Button x:Name="BtnRemove" Content="✕ Remove" Click="BtnRemove_Click" Margin="0,0,8,0" Padding="8,4"
                    ToolTip="Remove the selected source from the list (the file is not deleted)"/>
            <Button x:Name="BtnReload" Content="↻ Reload" Click="BtnReload_Click" Margin="0,0,8,0" Padding="8,4"
                    ToolTip="Apply the checkboxes and priorities and reload"/>
            <Button x:Name="BtnExportJson" Content="Export JSON" Click="BtnExportJson_Click" Margin="0,0,8,0" Padding="8,4"/>
            <Button x:Name="BtnExportMd" Content="Export Markdown" Click="BtnExportMd_Click" Margin="0,0,8,0" Padding="8,4"/>
            <Button x:Name="BtnOpenCache" Content="Open Cache Folder" Click="BtnOpenCache_Click" Margin="0,0,8,0" Padding="8,4"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Width="12"/>
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Main grid -->
        <DataGrid x:Name="SourcesGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  ItemsSource="{Binding Sources}" IsReadOnly="False"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  AlternatingRowBackground="#192A48">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding Enabled, Mode=TwoWay}" Width="35"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority, Mode=TwoWay}" Width="60" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Sheets" Binding="{Binding TotalSheets}" Width="55" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Rows" Binding="{Binding RowsRead}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Accepted" Binding="{Binding RowsAccepted}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Rejected" Binding="{Binding RowsRejected}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Unique IDs" Binding="{Binding UniqueIds}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Duplicates" Binding="{Binding Duplicates}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Conflicts" Binding="{Binding Conflicts}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewRecords}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Enriched" Binding="{Binding EnrichedRecords}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
                <DataGridTextColumn Header="Time [ms]" Binding="{Binding ElapsedMs, StringFormat='{}{0:F0}'}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource MonoStyle}"/>
            </DataGrid.Columns>

            <!-- Row details = sheet breakdown -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="4" Padding="8">
                        <DataGrid x:Name="SheetsGrid" AutoGenerateColumns="False"
                                  ItemsSource="{Binding Sheets}" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserSortColumns="True"
                                  AlternatingRowBackground="#192A48" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="140"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/>
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="60"/>
                                <DataGridTextColumn Header="Header row" Binding="{Binding HeaderRow}" Width="60" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Rows" Binding="{Binding RowsRead}" Width="60" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Accepted" Binding="{Binding RowsAccepted}" Width="60" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Rejected" Binding="{Binding RowsRejected}" Width="60" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Unique IDs" Binding="{Binding UniqueIds}" Width="70" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Duplicates" Binding="{Binding Duplicates}" Width="65" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Conflicts" Binding="{Binding Conflicts}" Width="60" ElementStyle="{StaticResource MonoStyle}"/>
                                <DataGridTextColumn Header="Mapping" Binding="{Binding MappingSummary}" Width="200"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding NotesSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Bottom bar -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnClose" Content="Close" Click="BtnClose_Click" Padding="16,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
