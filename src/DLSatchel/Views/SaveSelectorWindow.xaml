<Window x:Class="DDV_SaveEditor_G.SaveSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Save File"
        Icon="/DLSatchel;component/Assets/Icons/logo.png"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource Starlight}"
        FontFamily="Segoe UI" FontSize="13"
        Height="300" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="SaveGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Folder"   Binding="{Binding Folder}" Width="140"/>
                <DataGridTextColumn Header="Player"   Binding="{Binding Player}" Width="*"/>
                <DataGridTextColumn Header="Level"    Binding="{Binding Level}" Width="60"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="5" Click="Cancel_Click"/>
            <Button Content="Open" Width="80" Margin="5" Click="Open_Click"/>
        </StackPanel>
    </Grid>
</Window>
