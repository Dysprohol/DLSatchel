<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DDV_SaveEditor_G</RootNamespace>
    <ApplicationIcon>Assets\Icons\DLSatchel.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <Product>DL Satchel</Product>
    <AssemblyTitle>DL Satchel - save editor</AssemblyTitle>
    <Authors>Dysprohol</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- User-supplied catalogs are selected at runtime; only UI icons ship with the app. -->
  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>

  <!-- Taksonomia jest wbudowana; można opcjonalnie nadpisać ją plikiem obok EXE. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\taxonomy.json" LogicalName="DDV_SaveEditor_G.Data.taxonomy.json" />
    <!-- Fallback preset layouts for when the game folder is not found. -->
    <EmbeddedResource Include="Data\presets.json" LogicalName="DDV_SaveEditor_G.Data.presets.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DLSatchel.Tests" />
  </ItemGroup>

</Project>
